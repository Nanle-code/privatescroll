{
  "name": "@privatescroll/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compact:authorship": "compact compile src/authorship.compact managed/authorship",
    "compact:change": "compact compile src/document_change.compact managed/document_change",
    "compile": "npm run compact:authorship && npm run compact:change",
    "compile:fast": "compact compile --skip-zk src/authorship.compact managed/authorship && compact compile --skip-zk src/document_change.compact managed/document_change",
    "relayer": "tsx watch relayer.ts",
    "start": "tsx relayer.ts",
    "verify": "tsx verify.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongodb": "^6.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
